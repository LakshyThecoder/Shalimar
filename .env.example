PORT=8787
NODE_ENV=development
ADMIN_USER=Shalimar
ADMIN_PASS=Shalimar123@
SESSION_SECRET=change-this-to-a-long-random-string

# Public site URL used in canonical / Open Graph / sitemap (no trailing slash)
VITE_SITE_URL=https://www.shalimarmilano.store

# ── Vercel production (required for /admin on shalimarmilano.store) ──────────
# 1. Vercel Dashboard → Storage → Create Blob store → connect to this project
# 2. That adds BLOB_READ_WRITE_TOKEN automatically (or paste it here for local blob tests)
# 3. Also set ADMIN_USER, ADMIN_PASS, SESSION_SECRET, VITE_SITE_URL in Vercel → Settings → Env
BLOB_READ_WRITE_TOKEN=

# Local: npm run dev → http://localhost:5174/admin
# Production admin needs the Blob token above (Vercel has no persistent disk).

PORT=8787
NODE_ENV=development
ADMIN_USER=Shalimar
ADMIN_PASS=Shalimar123@
SESSION_SECRET=change-this-to-a-long-random-string

# Public site URL used in canonical / Open Graph / sitemap (no trailing slash)
VITE_SITE_URL=https://www.shalimarmilano.store
# Also set this same value in Vercel Project Settings → Environment Variables

# Local app: http://localhost:5174   Admin: http://localhost:5174/admin
# Production: npm run prod  (needs Node + persistent disk — NOT static-only hosting)
#
# Free storage (no database):
#   data/menu-store.json  — menus
#   data/site-store.json  — homepage text / phones / hours
#   public/uploads/       — photos (gitignored; keep on the server volume)
#
# Set strong ADMIN_* and SESSION_SECRET before going online.
# After deploy: set VITE_SITE_URL to your real domain and update public/robots.txt + sitemap.xml.

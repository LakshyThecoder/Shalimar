{
  "name": "shalimar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node --watch server/index.js",
    "seed:menu": "node server/seed.js",
    "seed:site": "node server/seedSite.js",
    "seed": "npm run seed:menu && npm run seed:site",
    "sitemap": "node scripts/generate-sitemap.js",
    "build": "npm run sitemap && vite build",
    "start": "node server/index.js",
    "prod": "npm run build && npm start",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.25.0",
    "multer": "^2.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-fast-marquee": "^1.6.5",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "serverless-http": "^4.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.17",
    "vite": "^8.1.1"
  }
}
